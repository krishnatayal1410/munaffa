# Munaffa backend configuration
# Demo mode is used automatically when the public Supabase values are absent.
# For production, create a Supabase project and apply every SQL migration in supabase/migrations/ in order.

# Safe for browser use. Configure these in Vercel Production/Preview.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Never expose this value through NEXT_PUBLIC_* or client code.
# Required by /api/leads to store demo/contact requests.
SUPABASE_SERVICE_ROLE_KEY=
